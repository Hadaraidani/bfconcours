    "signature": {
      "x": 70,
      "y": 194,
      "title": "Le Directeur",
      "name": "Formation Concours 2026",
      "titleStyle": { "fontSize": 10, "fontStyle": "normal", "color": "#4B5563", "align": "center" },
      "nameStyle": { "fontSize": 10, "fontStyle": "bold", "color": "#000000", "align": "center" },
      "lineColor": "#9CA3AF",
      "lineWidth": 0.5
    },
    "qrCode": {
      "x": 148.5,
      "y": 194,
      "size": 18,
      "visible": true,
      "label": "Scanner pour vérifier",
      "labelStyle": { "fontSize": 6, "fontStyle": "normal", "color": "#9CA3AF", "align": "center" }
    },
    "certificateId": {
      "x": 227,
      "y": 194,
      "label": "Certificat N°",
      "labelStyle": { "fontSize": 8, "fontStyle": "normal", "color": "#6B7280", "align": "center" },
      "valueStyle": { "fontSize": 10, "fontStyle": "bold", "color": "#1F2937", "align": "center" },
      "urlStyle": { "fontSize": 5, "fontStyle": "normal", "color": "#9CA3AF", "align": "center" },
      "maxUrlLength": 40
    }
  }
}
